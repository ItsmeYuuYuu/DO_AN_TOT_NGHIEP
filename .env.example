# Copy this file to .env for local development or deployment.
# Never commit the real .env file.

ASPNETCORE_ENVIRONMENT=Development
# On VPS use: ASPNETCORE_ENVIRONMENT=Production
# ASPNETCORE_URLS=http://127.0.0.1:5240

# PostgreSQL and optional Redis
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ECommerDB;Username=postgres;Password=YOUR_LOCAL_DB_PASSWORD
ConnectionStrings__Redis=

# JWT (use a long random value in production)
JwtSettings__SecretKey=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JwtSettings__Issuer=ECommerceAPI
JwtSettings__Audience=ECommerceFrontend
JwtSettings__ExpiryMinutes=15
JwtSettings__RefreshTokenDays=14

# Allowed browser origins, separated by semicolons
Cors__AllowedOrigins=http://localhost:5173;http://localhost:5174;http://localhost:4173;http://localhost:3000
Seo__SiteUrl=http://localhost:5173

# AI provider
AiAssistant__Provider=OpenAICompatible
AiAssistant__BaseUrl=http://localhost:11434/v1
AiAssistant__ApiKey=
AiAssistant__Model=qwen2.5:3b

# Gmail SMTP
Email__Enabled=false
Email__RequireRegistrationOtp=false
Email__Host=smtp.gmail.com
Email__Port=587
Email__EnableSsl=true
Email__Username=
Email__Password=
Email__FromEmail=
Email__FromName=Cuong Dien Thoai

# VietQR and SePay
PaymentQr__BankId=YOUR_BANK_BIN
PaymentQr__AccountNo=YOUR_ACCOUNT_NUMBER
PaymentQr__AccountName=YOUR_ACCOUNT_NAME
Sepay__ApiKey=YOUR_SEPAY_WEBHOOK_API_KEY

# Used only by start-local.bat
NGROK_DOMAIN=your-static-domain.ngrok-free.dev
