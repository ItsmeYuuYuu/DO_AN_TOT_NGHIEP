        <mxCell id="note" value="&lt;b&gt;Lưu ý:&lt;/b&gt; returnitems.imei và replacementimei cùng tham chiếu inventoryitems; sơ đồ gộp hai quan hệ vào một đường để tránh chồng chéo. resalevariantid có thể rỗng." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="1030" width="1060" height="90" as="geometry" /></mxCell>
